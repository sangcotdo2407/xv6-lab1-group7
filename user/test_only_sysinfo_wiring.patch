diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 3b4d5bd..07f352d 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -5,6 +5,7 @@
 #include "memlayout.h"
 #include "spinlock.h"
 #include "proc.h"
+#include "sysinfo.h"
 
 uint64
 sys_exit(void)
@@ -91,3 +92,20 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+// TEST-ONLY wiring so filetest can run before Thi's sys_sysinfo is merged.
+// Fills only the file half of struct sysinfo.
+static struct sysinfo kinfo;
+
+uint64
+sys_sysinfo(void)
+{
+  uint64 uaddr;
+
+  argaddr(0, &uaddr);
+  memset(&kinfo, 0, sizeof(kinfo));
+  collect_file_info(&kinfo);
+  if(copyout(myproc()->pagetable, uaddr, (char *)&kinfo, sizeof(kinfo)) < 0)
+    return -1;
+  return 0;
+}
